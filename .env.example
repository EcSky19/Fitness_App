# Vision provider: 'mock' | 'openai' | 'gemini'
EXPO_PUBLIC_VISION_PROVIDER=mock

# OpenAI (used when EXPO_PUBLIC_VISION_PROVIDER=openai)
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when EXPO_PUBLIC_VISION_PROVIDER=gemini)
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash
