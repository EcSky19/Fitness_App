# Vision provider: mock | openai | gemini
EXPO_PUBLIC_VISION_PROVIDER=mock

# DEVELOPMENT ONLY.
# EXPO_PUBLIC_* values are embedded verbatim in the JavaScript bundle by Metro.
# They are NOT secrets; anyone with the APK/bundle can extract them.
# Runtime code only reads these API-key fallbacks when __DEV__ is true.
# Use throwaway/rate-capped keys here, and never ship a distributed build with a
# real provider key in .env. Store real user-provided keys via Settings instead
# so they live in expo-secure-store.

# OpenAI (used when EXPO_PUBLIC_VISION_PROVIDER=openai)
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when EXPO_PUBLIC_VISION_PROVIDER=gemini)
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash
