{
  "expo": {
    "name": "MacroTrack",
    "slug": "macrotrack",
    "scheme": "macrotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macrotrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow MacroTrack to take photos of your food to estimate nutrition.",
        "NSPhotoLibraryUsageDescription": "Allow MacroTrack to access your photos to analyze food images and to illustrate your saved recipes."
      }
    },
    "android": {
      "package": "com.macrotrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MacroTrack to take photos of your food to estimate nutrition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MacroTrack to access your photos to analyze food images and to illustrate your saved recipes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1F2A"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
